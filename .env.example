# =========================================================
#  MIDTRANS  (https://dashboard.midtrans.com -> Settings -> Access Keys)
# =========================================================
# Gunakan kunci SANDBOX untuk testing. Ganti ke Production saat go-live.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# true = sandbox (app.sandbox.midtrans.com) | false = production (app.midtrans.com)
MIDTRANS_IS_PRODUCTION=false

# =========================================================
#  SUPABASE  (https://app.supabase.com -> Project Settings -> API)
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# SERVICE ROLE key -- SERVER ONLY, jangan pernah expose ke client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# =========================================================
#  APP
# =========================================================
# Base URL publik (dipakai untuk callback Snap & auto-set URL webhook Fonnte per device).
# Lokal: http://localhost:3000 — Produksi (Vercel): https://balestoko.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Kunci rahasia untuk menandatangani session login (HMAC). WAJIB di-set di produksi.
# Buat string acak panjang, mis: `openssl rand -hex 32`
AUTH_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter

# =========================================================
#  FONNTE  (https://fonnte.com -> Account Token, BUKAN device token)
# =========================================================
# Account Token dipakai untuk membuat device baru per-toko via API add-device.
# Ini SATU-SATUNYA token Fonnte yang perlu di-set di server (multi-tenant):
# tiap toko punya device token sendiri (disimpan di DB) hasil provisioning token
# ini. OTP reset password dikirim lewat device WhatsApp milik toko masing-masing,
# jadi TIDAK ada device token pengirim global di ENV.
FONNTE_TOKEN=your-fonnte-account-token
# CATATAN: satu toko bisa punya beberapa nomor (Starter 1, Pro 3) dan tiap nomor
# adalah device tersendiri di akun Fonnte Anda. Kuota device akun Fonnte harus
# cukup untuk total nomor semua toko. Fitur ini butuh tabel `store_devices` —
# jalankan ulang `supabase/schema.sql` bila deployment Anda dibuat sebelum ini.

# Shared secret untuk endpoint /api/fonnte/webhook. SANGAT DISARANKAN di produksi.
# Webhook menerima pesan dari internet publik dan setiap panggilan memicu Gemini
# + pengiriman WhatsApp berbayar ke nomor pada payload. Tanpa secret, siapa pun
# yang tahu nomor device sebuah toko bisa memakainya sebagai relay spam.
# Bila kosong: endpoint tetap terbuka (kompatibilitas deployment lama) dan
# menulis peringatan di log. Bila diisi, URL webhook device otomatis
# disinkronkan dengan `?secret=...` — tidak perlu setting manual di Fonnte.
# Device yang tersambung SEBELUM secret diaktifkan URL-nya masih tanpa secret;
# pesan pertama yang masuk tetap dilayani sekali sambil URL device diperbaiki,
# jadi tidak ada bot yang mati saat variabel ini baru ditambahkan.
# Buat string acak: `openssl rand -hex 32`
FONNTE_WEBHOOK_SECRET=

# =========================================================
#  GEMINI AI  (https://aistudio.google.com/apikey)
# =========================================================
# WAJIB agar balasan CS memakai AI Gemini. Bila kosong, bot tetap membalas
# tapi hanya pakai rule-based (sapaan/ongkir/katalog), bukan AI.
GEMINI_API_KEY=your-gemini-api-key
# (Opsional) Pilih model. Default: gemini-2.5-flash.
# CATATAN: gemini-1.5-flash & gemini-2.0-flash sudah di-shutdown Google.
GEMINI_MODEL=gemini-2.5-flash

# =========================================================
#  MENGANTAR  (Cek Ongkir) — https://mengantar.com
# =========================================================
# BIARKAN KOSONG. Cek ongkir memakai dua endpoint publik Mengantar:
#   - GET /api/public/{KEY}/address/search   -> segmen {KEY} TIDAK divalidasi
#   - GET /api/order/allEstimatePublic       -> sama sekali tanpa key
# (keduanya diverifikasi langsung ke api-public.mengantar.com)
#
# JANGAN menaruh API key akun Mengantar pribadi di sini pada deployment
# multi-tenant: semua toko akan memakai akun Anda (kuota, rate limit, dan
# diskon negosiasi Anda). Key per toko sudah didukung dan disimpan di DB —
# tiap pemilik toko mengisinya sendiri dari dashboard.
MENGANTAR_API_KEY=
# MENGANTAR_BASE_URL=https://api-public.mengantar.com
