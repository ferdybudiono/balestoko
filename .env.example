# =========================================================
#  MIDTRANS  (https://dashboard.midtrans.com -> Settings -> Access Keys)
# =========================================================
# Gunakan kunci SANDBOX untuk testing. Ganti ke Production saat go-live.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# true = sandbox (app.sandbox.midtrans.com) | false = production (app.midtrans.com)
MIDTRANS_IS_PRODUCTION=false

# ---- URL NOTIFIKASI (WEBHOOK) PER-TRANSAKSI ----
# Satu akun Midtrans dipakai untuk beberapa project, tapi dashboard Midtrans
# hanya punya SATU "Payment Notification URL" untuk seluruh akun. Karena itu
# aplikasi ini TIDAK mengandalkan kolom dashboard: setiap transaksi Snap dikirim
# dengan header `X-Override-Notification` berisi URL webhook project ini, jadi
# notifikasi pembayaran mustahil nyasar ke project lain (dan sebaliknya).
# Docs: https://docs.midtrans.com/reference/override-notification-url
#
# Default (MIDTRANS_NOTIFICATION_URL dibiarkan kosong): SEMUA domain aplikasi —
# NEXT_PUBLIC_BASE_URL + NEXT_PUBLIC_ALT_BASE_URLS — masing-masing ditambah
# `/api/midtrans/notification`. Mendaftarkan dua domain sekaligus membuat
# pembayaran tetap teraktivasi walau satu domain sedang bermasalah (DNS/SSL);
# notifikasi ganda aman karena transisi ke PAID pakai PATCH bersyarat.
#
# Isi variabel di bawah HANYA bila URL webhook berbeda dari domain aplikasi
# (mis. lewat tunnel ngrok saat development, atau proxy khusus) — nilainya
# MENGGANTIKAN daftar otomatis di atas. Boleh 1-3 URL dipisah koma; entri tanpa
# path otomatis dilengkapi `/api/midtrans/notification`. Wajib http(s) publik
# dengan port standar 80/443 — URL localhost atau jaringan privat diabaikan
# (header tidak dikirim) karena Midtrans memang tidak bisa menjangkaunya, dan
# mengoverride dengan alamat mati justru membuat notifikasi hilang total.
MIDTRANS_NOTIFICATION_URL=
# override (default) = ganti URL dashboard untuk transaksi ini — pilihan yang
#   benar untuk akun yang dipakai banyak project.
# append = URL dashboard TETAP dapat notifikasi, URL di atas ditambahkan.
# off    = jangan kirim header, murni pakai URL dashboard (perilaku lama).
MIDTRANS_NOTIFICATION_MODE=override

# =========================================================
#  SUPABASE  (https://app.supabase.com -> Project Settings -> API)
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# SERVICE ROLE key -- SERVER ONLY, jangan pernah expose ke client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# =========================================================
#  APP
# =========================================================
# Base URL publik (dipakai untuk callback Snap & auto-set URL webhook Fonnte per device).
# Lokal: http://localhost:3000 — Produksi (Vercel): https://balestoko.vercel.app
#
# WAJIB domain publik di produksi. Ini nilai yang didaftarkan ke Fonnte sebagai
# URL webhook, jadi kalau masih `http://localhost:3000` saat deploy:
# pendaftaran ke Fonnte tetap SUKSES, dashboard tampak sehat, dan tombol
# "Uji coba balasan AI" tetap membalas (jalur KIRIM) — tapi chat pembeli tidak
# pernah sampai karena Fonnte menembak localhost-nya sendiri. Tab WhatsApp
# sekarang menolak menyinkronkan dan menampilkan peringatan bila ini terjadi.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Domain LAIN tempat aplikasi ini juga dilayani, dipisah koma. Contoh nyata:
#   NEXT_PUBLIC_BASE_URL=https://balestoko.my.id
#   NEXT_PUBLIC_ALT_BASE_URLS=https://balestoko.vercel.app
#
# NEXT_PUBLIC_BASE_URL tetap SATU domain kanonik — ia yang didaftarkan ke Fonnte
# sebagai URL webhook device dan dipakai metadataBase (SEO), jadi nilainya tidak
# boleh berganti-ganti mengikuti domain yang sedang dibuka. Variabel ini hanya
# dipakai untuk dua hal yang memang harus sadar-domain:
#   1. URL notifikasi Midtrans — semua domain didaftarkan sekaligus (maks. 3),
#      jadi pembayaran tetap teraktivasi walau satu domain bermasalah.
#   2. Redirect pembeli setelah bayar — dia pulang ke domain yang dia pakai.
#      Tanpa ini, pembeli yang checkout di domain kedua dilempar ke domain
#      kanonik dan tampak logout, karena cookie sesi terikat host.
# Domain yang TIDAK terdaftar di sini (atau di NEXT_PUBLIC_BASE_URL) tidak akan
# pernah dipakai sebagai tujuan redirect — header Origin datang dari klien, jadi
# mempercayainya bulat-bulat sama dengan open redirect sesudah pembayaran.
NEXT_PUBLIC_ALT_BASE_URLS=

# Kunci rahasia untuk menandatangani session login (HMAC). WAJIB di-set di produksi.
# Buat string acak panjang, mis: `openssl rand -hex 32`
AUTH_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter

# =========================================================
#  FONNTE  (https://fonnte.com -> Account Token, BUKAN device token)
# =========================================================
# Account Token dipakai untuk membuat device baru per-toko via API add-device.
# Ini SATU-SATUNYA token Fonnte yang perlu di-set di server (multi-tenant):
# tiap toko punya device token sendiri (disimpan di DB) hasil provisioning token
# ini. OTP reset password dikirim lewat device WhatsApp milik toko masing-masing,
# jadi TIDAK ada device token pengirim global di ENV.
FONNTE_TOKEN=your-fonnte-account-token
# CATATAN: satu toko bisa punya beberapa nomor (Starter 1, Pro 3) dan tiap nomor
# adalah device tersendiri di akun Fonnte Anda. Kuota device akun Fonnte harus
# cukup untuk total nomor semua toko. Fitur ini butuh tabel `store_devices` —
# jalankan ulang `supabase/schema.sql` bila deployment Anda dibuat sebelum ini.

# Shared secret untuk endpoint /api/fonnte/webhook. SANGAT DISARANKAN di produksi.
# Webhook menerima pesan dari internet publik dan setiap panggilan memicu Gemini
# + pengiriman WhatsApp berbayar ke nomor pada payload. Tanpa secret, siapa pun
# yang tahu nomor device sebuah toko bisa memakainya sebagai relay spam.
# Bila kosong: endpoint tetap terbuka (kompatibilitas deployment lama) dan
# menulis peringatan di log. Bila diisi, URL webhook device otomatis
# disinkronkan dengan `?secret=...` — tidak perlu setting manual di Fonnte.
# Device yang tersambung SEBELUM secret diaktifkan URL-nya masih tanpa secret;
# pesan pertama yang masuk tetap dilayani sekali sambil URL device diperbaiki,
# jadi tidak ada bot yang mati saat variabel ini baru ditambahkan. Hal yang sama
# berlaku saat nilainya DIROTASI atau domain aplikasi berubah: URL device
# dibandingkan persis, yang lama masuk jalur perbaikan sekali-pakai, bukan
# ditolak selamanya.
# Buat string acak: `openssl rand -hex 32`
FONNTE_WEBHOOK_SECRET=

# CATATAN AUTO READ: Fonnte hanya mengirim pesan masuk ke webhook bila setelan
# `auto read` device MENYALA. Aplikasi ini menyalakannya otomatis saat nomor
# dibuat, saat QR dibuka, dan saat tab WhatsApp dimuat — tidak ada yang perlu
# disetel manual di dashboard Fonnte. Saat nomor baru dibuat, hasilnya juga
# DIBACA ULANG dari Fonnte (bukan disimpulkan dari "request kami tidak error"),
# dan auto read tetap dinyalakan walau NEXT_PUBLIC_BASE_URL belum publik —
# menyalakannya tidak butuh URL, dan menundanya membuat nomor itu bisu nanti.
# Kondisinya ditampilkan per nomor di tab WhatsApp, lengkap dengan tombol
# "Perbaiki otomatis" bila melenceng.
# Kolom penunjangnya (`autoread`, `last_inbound_at`, `last_inbound_note`) ada di
# `supabase/schema.sql` — jalankan ulang file itu bila deployment Anda lebih tua.

# =========================================================
#  GEMINI AI  (https://aistudio.google.com/apikey)
# =========================================================
# WAJIB agar balasan CS memakai AI Gemini. Bila kosong, bot tetap membalas
# tapi hanya pakai rule-based (sapaan/ongkir/katalog), bukan AI.
GEMINI_API_KEY=your-gemini-api-key
# (Opsional) Pilih model. Default: gemini-2.5-flash.
# CATATAN: gemini-1.5-flash & gemini-2.0-flash sudah di-shutdown Google.
GEMINI_MODEL=gemini-2.5-flash

# =========================================================
#  MENGANTAR  (Cek Ongkir) — https://mengantar.com
# =========================================================
# BIARKAN KOSONG. Cek ongkir memakai dua endpoint publik Mengantar:
#   - GET /api/public/{KEY}/address/search   -> segmen {KEY} TIDAK divalidasi
#   - GET /api/order/allEstimatePublic       -> sama sekali tanpa key
# (keduanya diverifikasi langsung ke api-public.mengantar.com)
#
# JANGAN menaruh API key akun Mengantar pribadi di sini pada deployment
# multi-tenant: semua toko akan memakai akun Anda (kuota, rate limit, dan
# diskon negosiasi Anda).
#
# Kolom `mengantar_api_key` per toko masih ada di database dan tetap dipakai bila
# sudah terisi, tapi inputnya SUDAH DIHAPUS dari dashboard: karena kedua endpoint
# di atas tidak memvalidasi key, mengisinya tidak pernah membuat ongkir jadi
# akurat — yang menentukan adalah lokasi asal toko dipilih dari hasil pencarian
# Mengantar. Menyisakan kolom itu di dashboard hanya membuat pemilik toko mengira
# sedang memperbaiki sesuatu.
MENGANTAR_API_KEY=
# MENGANTAR_BASE_URL=https://api-public.mengantar.com
